# --- LLM -------------------------------------------------------------------
# DeepSeek V4.1 Flash via Synthetic's OpenAI-compatible API.
# Get a key at https://synthetic.new/ (the same key works in any OpenAI-compatible client).
LLM_API_KEY=
LLM_BASE_URL=https://api.synthetic.new/openai/v1
LLM_MODEL=hf:deepseek-ai/DeepSeek-V4.1-Flash-1017

# Optional fallbacks: SYNTHETIC_API_KEY or DEEPSEEK_API_KEY are also read if
# LLM_API_KEY is unset. Point LLM_BASE_URL/LLM_MODEL at another compatible
# provider to swap models without changing code.

# --- Database --------------------------------------------------------------
# Local-first SQLite. Swap the repository layer for Postgres when deploying.
DATABASE_PATH=./data/dental.db

# --- Practice configuration ------------------------------------------------
PRACTICE_TIMEZONE=America/New_York
NEXT_PUBLIC_APP_NAME=Lakeside Family Dental

# --- Mock authentication ---------------------------------------------------
# Used to sign the patient/staff session cookie. Change this outside local dev.
SESSION_SECRET=replace-with-a-long-random-secret
STAFF_EMAIL=frontdesk@lakeside.test
STAFF_PASSWORD=frontdesk-demo

# --- Optional staff notifications -----------------------------------------
# If unset, alerts stay in the in-app staff console.
STAFF_WEBHOOK_URL=
